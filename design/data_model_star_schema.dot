legend [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3" BGCOLOR="#fafafa"><TR><TD COLSPAN="2"><B>Legend</B></TD></TR><TR><TD BGCOLOR="#fff2cc">PK</TD><TD ALIGN="LEFT">Primary key</TD></TR><TR><TD BGCOLOR="#fff9e6">NK</TD><TD ALIGN="LEFT">Natural / alternate key</TD></TR><TR><TD BGCOLOR="#e8f0fe">FK</TD><TD ALIGN="LEFT">Foreign key (text colour = target dimension)</TD></TR><TR><TD BGCOLOR="#f3f3f3">{ }</TD><TD ALIGN="LEFT">Nested JSON / array</TD></TR><TR><TD BGCOLOR="#fde2e2">!</TD><TD ALIGN="LEFT">Attacker-controllable text (treat as data, never instructions)</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><B>Join normalisation</B></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT">user_key = lower(username); map upn, TARVIA\user, svc_* to it</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT">Internal IP → dim_zone via CIDR range join; external IP → dim_ip</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT">fact_change / fact_hr_event: join on entity + time window</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT">All timestamps UTC; Madrid = UTC+2 (UTC+1 from 25-Oct)</TD></TR></TABLE>>];
}