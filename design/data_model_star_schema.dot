"fact_alert":palert_id -> "fact_ticket":palert_ids___ [color="#6c3483", penwidth=2, label="N alerts → 1 ticket", fontsize=10];
"dim_date":pts_utc -> "fact_alert":pcreated_at [color="#555555", style=dotted, dir=back];
"dim_user":puser_key -> "bridge_alert_entity":pentity_key____user_asset_ip_ind_file_cust_ [color="#999999", style=dotted, dir=back, constraint=false];
"dim_asset":phostname -> "bridge_alert_entity":pentity_key____user_asset_ip_ind_file_cust_ [color="#999999", style=dotted, dir=back, constraint=false];
"dim_ip":pip -> "bridge_alert_entity":pentity_key____user_asset_ip_ind_file_cust_ [color="#999999", style=dotted, dir=back, constraint=false];
"dim_indicator":pvalue -> "bridge_alert_entity":pentity_key____user_asset_ip_ind_file_cust_ [color="#999999", style=dotted, dir=back, constraint=false];
"dim_file":psha256 -> "bridge_alert_entity":pentity_key____user_asset_ip_ind_file_cust_ [color="#999999", style=dotted, dir=back, constraint=false];
"dim_customer":pcustomer_id -> "bridge_alert_entity":pentity_key____user_asset_ip_ind_file_cust_ [color="#999999", style=dotted, dir=back, constraint=false];
"bridge_alert_event":pevent_id -> "idp_signins":pevent_id [color="#c0392b", style=dashed, penwidth=2, lhead=cluster_logs, constraint=false, label="related_events → event_id (any log table, by prefix)", fontcolor="#c0392b", fontsize=12];
"email_clicks":pmessage_id -> "email":pmessage_id [color="#3b6fb6", style=dashed, constraint=false, label="message_id", fontsize=9];
{rank=same; "idp_signins" "idp_audit" "ad_events" "vpn" "edr_events" "dlp" "proxy" "dns" "firewall"}
{rank=same; "email" "email_clicks" "waf" "ecom_auth" "ecom_account" "ai_gateway" "cloudtrail" "sql_audit" "cicd_builds"}
