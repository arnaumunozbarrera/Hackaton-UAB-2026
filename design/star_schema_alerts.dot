"dim_context" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#b8860b"><FONT COLOR="white" POINT-SIZE="17"><B>dim_context</B></FONT></TD></TR><TR><TD COLSPAN="3" BGCOLOR="#b8860b"><FONT COLOR="white" POINT-SIZE="10">CONTEXT + INTELLIGENCE · ti_feed, geoip_asn, sandbox, calendario_cambios</FONT></TD></TR><TR><TD BGCOLOR="#fff2cc" WIDTH="26" PORT="pcontext_key_l"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#fff2cc" PORT="pcontext_key" WIDTH="170"><FONT POINT-SIZE="12"><B>context_key</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#fff2cc" PORT="pcontext_key_r"><FONT POINT-SIZE="10" COLOR="#666666">indicator value or change id</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" WIDTH="26" PORT="pcontext_type_l"><FONT POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="pcontext_type" WIDTH="170"><FONT POINT-SIZE="12">context_type</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="pcontext_type_r"><FONT POINT-SIZE="10" COLOR="#666666">ioc / ip / file / change</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" WIDTH="26" PORT="preputation___confidence_l"><FONT POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="preputation___confidence" WIDTH="170"><FONT POINT-SIZE="12">reputation / confidence</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="preputation___confidence_r"><FONT POINT-SIZE="10" COLOR="#666666">TIP (unknown ≠ clean)</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" WIDTH="26" PORT="pmalware_family___tags_l"><FONT POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="pmalware_family___tags" WIDTH="170"><FONT POINT-SIZE="12">malware_family / tags</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="pmalware_family___tags_r"><FONT POINT-SIZE="10" COLOR="#666666">TIP / sandbox</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" WIDTH="26" PORT="pcountry___asn___as_org_l"><FONT POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="pcountry___asn___