graph G {
graph [layout=neato, splines=curved, forcelabels=true, overlap=false, pad=0.5, fontname="Helvetica",
 label=<<FONT POINT-SIZE="28"><B>Tarvia SOC — Star-join schema for L1 triage</B></FONT><BR/><FONT POINT-SIZE="14">Fact table: alerts · Dimensions: rules, users, vulnerabilities (asset exposure), context + intelligence, logs</FONT>>, labelloc=t];
node [shape=plaintext, fontname="Helvetica"]; edge [penwidth=2.2, fontname="Helvetica", fontsize=12];
"fact_alert" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#c0392b"><FONT COLOR="white" POINT-SIZE="20"><B>fact_alert</B></FONT></TD></TR><TR><TD COLSPAN="3" BGCOLOR="#c0392b"><FONT COLOR="white" POINT-SIZE="10">FACT · alertas.jsonl (11,061)</FONT></TD></TR><TR><TD BGCOLOR="#fff2cc" WIDTH="26" PORT="palert_id_l"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#fff2cc" PORT="palert_id" WIDTH="190"><FONT POINT-SIZE="12"><B>alert_id</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#fff2cc" PORT="palert_id_r"><FONT POINT-SIZE="10" COLOR="#666666">&#160;</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" WIDTH="26" PORT="pcreated_at_l"><FONT POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="pcreated_at" WIDTH="190"><FONT POINT-SIZE="12">created_at</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="pcreated_at_r"><FONT POINT-SIZE="10" COLOR="#666666">UTC</FONT></TD></TR><TR><TD BGCOLOR="#e8f0fe" WIDTH="26" PORT="prule_id_l"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#e8f0fe" PORT="prule_id" WIDTH="190"><FONT POINT-SIZE="12"><B>rule_id</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#e8f0fe" PORT="prule_id_r"><FONT POINT-SIZE="10" COLOR="#666666">→ dim_rule</FONT></TD></TR><TR><TD BGCOLOR="#e8f0fe" WIDTH="26" PORT="puser_key_l"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#e8f0fe" PORT="puser_key" WIDTH="190"><FONT POINT-SIZE="12"><B>user_key</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#e8f0fe" PORT="puser_key_r"><FONT POINT-SIZE="10" COLOR="#666666">→ dim_user</FONT></TD></TR><TR><TD BGCOLOR="#e8f0fe" WIDTH="26" PORT="phostname_l"><FONT POINT-SIZE="10">FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#e8f0fe" PORT="phostname" WIDTH="190"><FONT POINT-SIZE="12"><B>hostname</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#e8f0fe" PORT="phostname_r"><FONT POINT-SIZE="10" COLOR="#666666">→ dim_vulnerability</FONT></TD></TR><TR><TD BGCOLOR="#e8f0fe" WIDTH="26" PORT="pcontext_key_l"><FONT PO