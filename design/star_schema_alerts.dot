"dim_log" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#3b6fb6"><FONT COLOR="white" POINT-SIZE="17"><B>dim_log</B></FONT></TD></TR><TR><TD COLSPAN="3" BGCOLOR="#3b6fb6"><FONT COLOR="white" POINT-SIZE="10">LOGS · unified view over 18 sources (814k events)</FONT></TD></TR><TR><TD BGCOLOR="#fff2cc" WIDTH="26" PORT="pevent_id_l"><FONT POINT-SIZE="10">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#fff2cc" PORT="pevent_id" WIDTH="170"><FONT POINT-SIZE="12"><B>event_id</B></FONT></TD><TD ALIGN="LEFT" BGCOLOR="#fff2cc" PORT="pevent_id_r"><FONT POINT-SIZE="10" COLOR="#666666">prefix = source</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" WIDTH="26" PORT="psource_l"><FONT POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="psource" WIDTH="170"><FONT POINT-SIZE="12">source</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="psource_r"><FONT POINT-SIZE="10" COLOR="#666666">proxy, edr, idp_signins, ...</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" WIDTH="26" PORT="ptimestamp_l"><FONT POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="ptimestamp" WIDTH="170"><FONT POINT-SIZE="12">timestamp</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="ptimestamp_r"><FONT POINT-SIZE="10" COLOR="#666666">UTC</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" WIDTH="26" PORT="puser_key_l"><FONT POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="puser_key" WIDTH="170"><FONT POINT-SIZE="12">user_key</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="puser_key_r"><FONT POINT-SIZE="10" COLOR="#666666">normalised</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" WIDTH="26" PORT="phostname_l"><FONT POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="phostname" WIDTH="170"><FONT POINT-SIZE="12">hostname</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="phostname_r"><FONT POINT-SIZE="10" COLOR="#666666">&#160;</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" WIDTH="26" PORT="psrc_ip___dst_l"><FONT POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="psrc_ip___dst" WIDTH="170"><FONT POINT-SIZE="12">src_ip / dst</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="psrc_ip___dst_r"><FONT POINT-SIZE="10" COLOR="#666666">IP, domain or URL</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" WIDTH="26" PORT="paction___result_l"><FONT POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="paction___result" WIDTH="170"><FONT POINT-SIZE="12">action / result</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="paction___result_r"><FONT POINT-SIZE="10" COLOR="#666666">allowed, blocked, success</FONT></TD></TR><TR><TD BGCOLOR="#ffffff" WIDTH="26" PORT="psha256_l"><FONT POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="psha256" WIDTH="170"><FONT POINT-SIZE="12">sha256</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#ffffff" PORT="psha256_r"><FONT POINT-SIZE="10" COLOR="#666666">EDR / email</FONT></TD></TR><TR><TD BGCOLOR="#fde2e2" WIDTH="26" PORT="pdetail_l"><FONT POINT-SIZE="10">{ }</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#fde2e2" PORT="pdetail" WIDTH="170"><FONT POINT-SIZE="12">detail</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#fde2e2" PORT="pdetail_r"><FONT POINT-SIZE="10" COLOR="#666666">raw record (untrusted)</FONT></TD></TR></TABLE>>, pos="0,-8.4!"];
