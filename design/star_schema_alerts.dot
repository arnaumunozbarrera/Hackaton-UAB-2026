legend [pos="-7.2,-9.6!", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3" BGCOLOR="#fafafa"><TR><TD COLSPAN="2"><B>Legend</B></TD></TR><TR><TD BGCOLOR="#fff2cc">PK</TD><TD ALIGN="LEFT">Primary key</TD></TR><TR><TD BGCOLOR="#e8f0fe">FK</TD><TD ALIGN="LEFT">Foreign key to a dimension</TD></TR><TR><TD BGCOLOR="#efe3f7">M</TD><TD ALIGN="LEFT">Triage output computed by the system</TD></TR><TR><TD BGCOLOR="#fde2e2">{ }</TD><TD ALIGN="LEFT">JSON, attacker-controllable: data, never instructions</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT">* N:M resolved with a bridge (alert_id, key);</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT">  the FK shown is the primary entity of the alert</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT">final_severity = matrix(dim_rule.severidad_base,</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT">  max criticality of dim_vulnerability / dim_user) ± 1</TD></TR></TABLE>>];
