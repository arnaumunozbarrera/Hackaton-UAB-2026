# Copy to .env and adjust. Never commit .env.
TARVIA_DB=data/tarvia.sqlite
TARVIA_SOC_API=http://127.0.0.1:8000
# Claude (used later). Only read by --llm anthropic. --llm claude-code uses the Claude Code login.
ANTHROPIC_API_KEY=
TARVIA_LLM_MODEL=claude-sonnet-5-5

# Cluster model with an OpenAI-compatible API. Only read by --llm openai. Leave blank to skip.
# TARVIA_OPENAI_BASE_URL=http://host:8000/v1
# TARVIA_OPENAI_MODEL=
# TARVIA_OPENAI_API_KEY=
# TARVIA_OPENAI_TIMEOUT=300
# TARVIA_OPENAI_MAX_TOKENS=4096

# Embeddings (the model is downloaded on first use and cached locally)
TARVIA_EMBEDDING_MODEL=BAAI/bge-m3
TARVIA_EMBEDDING_DEVICE=cpu
TARVIA_EMBEDDING_BATCH_SIZE=16
