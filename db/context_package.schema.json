{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tarvia SOC LLM context package",
  "type": "object",
  "required": ["meta", "input_alert", "similar_alerts", "linked_incidents", "attack_timeline", "change_overlap", "duplicates", "prioritised_events", "contiguous_logs", "sample_logs", "prefilter", "untrusted_fields"],
  "properties": {
    "meta": {"type": "object", "required": ["generated_at", "window_alert_hours", "window_log_minutes", "schema_version", "truncation", "prefilter"], "properties": {"generated_at": {"type": "string"}, "window_alert_hours": {"const": 24}, "window_log_minutes": {"const": 10}, "schema_version": {"type": "string"}, "truncation": {"type": "object"}, "prefilter": {"type": "object", "required": ["enabled", "decision", "withheld_counts", "guard_applied_count", "errors"]}}},
    "input_alert": {"type": "object", "required": ["raw", "normalised", "resolved_entities", "enrichment", "prefilter_flag"]},
    "similar_alerts": {"type": "array"}, "linked_incidents": {"type": "array"}, "attack_timeline": {"type": "array"}, "change_overlap": {"type": "array"}, "duplicates": {"type": "array"}, "prioritised_events": {"type": "array"}, "contiguous_logs": {"type": "array"}, "sample_logs": {"type": "array"},
    "prefilter": {"type": "array", "items": {"type": "object", "required": ["item_type", "item_id", "filter_id", "filter_name", "filter_category", "matched_field", "matched_value_reference", "decision"]}},
    "untrusted_fields": {"type": "array", "items": {"type": "string"}}
  }
}
